{
  "name": "kacakcidan",
  "version": "1.0.0",
  "private": true,
  "description": "İkinci el online ilan ve alışveriş sitesi. Expo, React Native ve TypeScript ile geliştirildi.",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "scripts": {
    "postinstall": "node scripts/harita-kaynaklari.mjs",
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "node scripts/derle.mjs",
    "preview": "sirv dist --port 3000",
    "typecheck": "tsc --noEmit",
    "typegen": "expo customize tsconfig.json",
    "check": "npm run typegen && npm run typecheck && expo install --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/metro-runtime": "~58.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.11",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.13",
    "leaflet": "1.9.4",
    "lucide-react-native": "^1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "overrides": {
    "@expo/cli": {
      "glob": "14.0.3"
    },
    "@expo/fingerprint": {
      "glob": "14.0.3",
      "minimatch": "11.0.4"
    }
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.3.0",
    "parse5": "^8.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "sirv-cli": "^3.0.1",
    "typescript": "~6.0.0"
  }
}
